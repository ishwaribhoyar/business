# ==============================================================================
# ENVIRONMENT CONFIGURATION - DIGITAL BUILDING-MATERIAL MARKETPLACE (NAGPUR MVP)
# ==============================================================================
# Safe template for development, staging, and production.
# Copy this file to .env and configure values before starting the application.
# NEVER commit the real .env file with production credentials to source control.

# Application Environment (development | test | production)
NODE_ENV=development
PORT=5000
HOST=localhost

# Frontend Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1

# Database Configuration
# Local development uses SQLite file path; Production supports PostgreSQL connection string.
DATABASE_URL=file:./data/marketplace.sqlite
# Example PostgreSQL for Production:
# DATABASE_URL=postgresql://marketplace_user:strong_password@localhost:5432/marketplace_db?schema=public

# Authentication & JWT Security
# Generate strong 64+ char random secret for production (e.g., openssl rand -base64 48)
JWT_SECRET=development_only_secret_change_me_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed (Used ONLY for initial database seeding in development/setup)
INITIAL_ADMIN_EMAIL=admin@nagpurmaterials.local
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
INITIAL_ADMIN_NAME="Operations Admin"

# Business & Operational Contact Information (Nagpur Local Operations)
BUSINESS_NAME="Nagpur Building Materials"
BUSINESS_SERVICE_AREA="Nagpur and nearby serviceable areas"
BUSINESS_PHONE="+917120000000"
BUSINESS_WHATSAPP="+919876543210"
BUSINESS_SUPPORT_EMAIL="support@nagpurmaterials.local"

# Logging Configuration (error | warn | info | http | debug)
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
