# ==============================================================================
# RENDER PRODUCTION ENVIRONMENT VARIABLES
# Copy and paste this directly into Render -> "Add from .env"
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Database Configuration (Replace with your Render PostgreSQL Internal Connection String)
# Example: postgresql://marketplace_user:PASSWORD@dpg-xxxx-a.singapore-postgres.render.com/marketplace_db
DATABASE_URL=postgresql://replace_with_your_render_postgres_internal_url

# Security & Authentication (Pre-generated 64-char secure random secret)
JWT_SECRET=abd1ce9447ae946ce5ec32ed81cb9fa6df677784a47982b816755718df12d956
JWT_EXPIRES_IN=7d

# CORS & Client Integration
CORS_ORIGINS=*
CLIENT_URL=https://nagpur-marketplace-frontend.onrender.com

# Initial Super Admin Account (Created automatically on first startup)
INITIAL_ADMIN_EMAIL=admin@nagpurmaterials.local
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
INITIAL_ADMIN_NAME=Operations Admin

# Local Business Details (Nagpur Operations)
BUSINESS_NAME=Nagpur Building Materials
BUSINESS_SERVICE_AREA=Nagpur and nearby serviceable areas
BUSINESS_PHONE=+917120000000
BUSINESS_WHATSAPP=+919876543210
BUSINESS_SUPPORT_EMAIL=support@nagpurmaterials.local

# Operational Logging & Rate Limiting
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
